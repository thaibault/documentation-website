{
  "name": "web-documentation",
  "version": "1.0.49",
  "description": "Declarative multilanguage documentation website generator",
  "keywords": [
    "documentation",
    "website",
    "homepage",
    "page",
    "project"
  ],
  "bugs": {
    "email": "info@torben.website",
    "url": "https://github.com/thaibault/wbe-documentation/issues"
  },
  "license": "CC-BY-3.0",
  "author": {
    "email": "info@torben.website",
    "name": "Torben Sickert",
    "url": "https://torben.website"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thaibault/web-documentation"
  },
  "type": "module",
  "main": "source/index.html.ejs",
  "bin": "build/deploy.js",
  "files": [
    "build/deploy.js",
    "build/deploy.d.ts",
    "source"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "yarn build:types; yarn build:web; yarn build:deploy",
    "build:deploy": "weboptimizer build '{__reference__: \"target:deploy\"}'",
    "build:stats": "weboptimizer build --profile --json /tmp/stats.json | sed --regexp-extended 's/^Running \".+$//' | sed --regexp-extended 's/^Consolidate module request \".+$//' >/tmp/stats.json && echo 'Results successfully written to \"/tmp/stats.json\".'",
    "build:types": "weboptimizer build:types",
    "build:web": "weboptimizer build",
    "check": "yarn check:types; yarn lint",
    "check:types": "weboptimizer check:types",
    "clear": "weboptimizer clear",
    "document": "weboptimizer document",
    "lint": "weboptimizer lint",
    "prepare": "yarn build",
    "serve": "weboptimizer serve",
    "start": "yarn serve",
    "test": "yarn clear && weboptimizer test",
    "test:browser": "yarn clear && weboptimizer test:browser",
    "test:coverage": "yarn clear && weboptimizer test:coverage",
    "test:coverage:report": "yarn clear && weboptimizer test:coverage:report",
    "watch": "weboptimizer build --watch"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@babel/eslint-parser": "^8.0.1",
    "@babel/runtime": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/archiver": "^8.0.0",
    "@types/ejs": "^3.1.5",
    "@types/html-minifier": "^4.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/marked": "^6.0.0",
    "@types/node": "^26.2.0",
    "@types/unzipper": "^0.10.11",
    "@types/webpack-env": "^1.18.8",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@webcomponents/webcomponentsjs": "^2.8.0",
    "archiver": "^8.0.0",
    "bootstrap-icons": "^1.13.1",
    "clientnode": "^4.0.1484",
    "css-loader": "^7.1.4",
    "cssnano": "^8.0.6",
    "default-gateway": "^7.2.2",
    "errorreporter": "^1.0.357",
    "eslint": "^10.8.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-jsdoc": "^64.2.1",
    "favicons": "^7.3.1",
    "favicons-webpack-plugin": "^6.0.1",
    "highlight.js": "^11.12.0",
    "jest": "30.4.2",
    "jsdoc": "^4.0.5",
    "legal-notes": "^1.0.29",
    "marked": "^18.0.10",
    "marked-gfm-heading-id": "^4.1.4",
    "marked-highlight": "^2.2.4",
    "marked-xhtml": "^1.0.15",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.26",
    "postcss-fontpath": "^1.0.0",
    "postcss-import": "^17.0.0",
    "postcss-loader": "^8.2.1",
    "postcss-mixins": "^12.1.2",
    "postcss-nested": "^8.0.1",
    "postcss-preset-env": "^11.4.0",
    "postcss-scss": "^4.0.9",
    "postcss-sprites": "^4.2.1",
    "postcss-url": "^10.1.4",
    "prop-types": "^15.8.1",
    "style-loader": "^4.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript-eslint": "^8.67.0",
    "ua-parser-js": "^2.0.10",
    "unzipper": "^0.12.5",
    "web-component-wrapper": "^0.0.611",
    "web-internationalization": "^2.0.50",
    "weboptimizer": "^4.0.53",
    "webpack-dev-server": "^6.0.0",
    "website-utilities": "^1.0.464"
  },
  "resolutions": {
    "colors": "1.4.0",
    "globals@npm:^11.1.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^14.0.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch",
    "globals@npm:^9.18.0": "patch:globals@npm%3A11.12.0#~/.yarn/patches/globals-npm-11.12.0-1fa7f41a6c.patch"
  },
  "engines": {
    "node": ">=26",
    "npm": ">=12",
    "yarn": ">=4"
  },
  "webOptimizer": {
    "build": {
      "definitions": {
        "LANGUAGES": {
          "__evaluate__": "`['${self.module.preprocessor.html.options.locals.LANGUAGES.join(\"', '\")}']`"
        },
        "TRACKING_CODE": {
          "__evaluate__": "`'${self.module.preprocessor.html.options.locals.TRACKING_CODE}'`"
        }
      }
    },
    "commandLine": {
      "test": {
        "environments": [
          "jsdom"
        ]
      }
    },
    "injection": {
      "chunks": false,
      "entry": {
        "#": "errorreporter\": [\"ua-parser-js\", \"errorreporter\"]",
        "__evaluate__": "2 < self.givenCommandLineArguments.length && self.givenCommandLineArguments[2].startsWith('test') ? {testBundle: './test.ts'} : {index: ['./index.css', '@webcomponents/webcomponentsjs/webcomponents-bundle.js', '@webcomponents/webcomponentsjs/custom-elements-es5-adapter.js', './index']}"
      },
      "external": {
        "#": "Externalize other's pre-build libraries for the test target so jest resolves the published bundles at runtime instead of re-bundling them.",
        "implicit": {
          "pattern": {
            "include": {
              "__evaluate__": "['@jest/globals'].concat(2 < self.givenCommandLineArguments.length && self.givenCommandLineArguments[2].startsWith('test') ? /^(?:clientnode|web-component-wrapper|website-utilities|web-internationalization|errorreporter)(?:$|\\/)/ : [])"
            }
          }
        }
      }
    },
    "library": false,
    "module": {
      "aliases": {
        "web-component-wrapper/decorator$": "web-component-wrapper/compatible/decorator",
        "web-component-wrapper/Web": "web-component-wrapper/compatible/Web"
      },
      "enforceDeduplication": true,
      "html": {
        "options": {
          "sources": {
            "urlFilter": {
              "#": "Do not process any referenced resource in HTML.",
              "__evaluate__": "() => false"
            }
          }
        }
      },
      "optimizer": {
        "#": "We have to add disable \"mergeRules\" since it removes header link color over writing.",
        "cssnano": {
          "__await_evaluate__": "module.optionalImport('cssnano-preset-default').then((module) => self.debug ? null : {preset: [module?.default, {autoprefixer: false, discardUnused: !self.library, mergeRules: false}]})"
        },
        "htmlMinifier": {
          "ignoreCustomComments": [
            {
              "__evaluate__": "/^\\|?[a-z]{2}[A-Z]{2}:/"
            },
            {
              "__evaluate__": "/^[a-z]{2}[A-Z]{2}$/"
            },
            {
              "__evaluate__": "/^showExample(?::[a-zA-Z]+)?$/"
            }
          ]
        },
        "terser": {
          "terserOptions": {
            "compress": {
              "#": "To provide a logging output we need to exclude this feature.",
              "drop_console": {
                "__evaluate__": "false"
              },
              "drop_debugger": {
                "__evaluate__": "false"
              }
            }
          }
        }
      },
      "preprocessor": {
        "cascadingStyleSheet": {
          "additional": {
            "plugins": {
              "pre": {
                "__append__": [
                  "module.optionalImport('postcss-mixins').then((module) => module?.default)",
                  "module.optionalImport('postcss-nested').then((module) => module?.default)"
                ]
              }
            }
          }
        },
        "ejs": {
          "options": {
            "locals": {
              "API_DOCUMENTATION_PATH": "api/",
              "CONTENT": "source/dummyReadme.md",
              "DISTRIBUTION_BUNDLE_FILE_PATH": "dummyDistributionBundle.zip",
              "HAS_API_DOCUMENTATION": true,
              "LANGUAGES": {
                "__evaluate__": "self.module.preprocessor.html.options.locals.NAME === 'web-documentation' ? ['enUS', 'deDE', 'frFR'] : ['enUS']"
              },
              "MARKED_OPTIONS": {
                "#": "If true, add <br> on a single line break (copies GitHub behavior on comments, but not on rendered markdown files). Requires gfm be true.",
                "#1": "If true, use approved GitHub Flavored Markdown (GFM) specification.",
                "#2": "If true, conform to the original markdown.pl as much as possible. Don't fix original markdown bugs or behavior. Turns off and overrides gfm.",
                "#3": "If true, the parser does not throw any exception.",
                "async": true,
                "breaks": false,
                "gfm": true,
                "pedantic": false,
                "silent": false
              },
              "META_TAGS": [],
              "NAME": "web-documentation",
              "READ_FILE": {
                "__evaluate__": "fs.promises.readFile"
              },
              "RENDER_MARKDOWN": {
                "__await_evaluate__": "module.optionalImport(path.resolve(currentPath, 'source/renderMarkdown.mjs')).then((module) => module?.default(self.module.preprocessor.ejs.options.locals.MARKED_OPTIONS))"
              },
              "SOURCE_URL": {
                "__evaluate__": "`https://github.com/thaibault/${self.module.preprocessor.html.options.locals.NAME}`"
              },
              "TAGLINE": "generic documentation website pattern",
              "URL": {
                "__evaluate__": "`https://torben.website/${self.module.preprocessor.html.options.locals.NAME}`"
              }
            }
          }
        }
      }
    },
    "offline": null,
    "path": {
      "source": {
        "asset": {
          "cascadingStyleSheet": "./",
          "javaScript": "./"
        }
      },
      "target": {
        "asset": {
          "cascadingStyleSheet": "./",
          "javaScript": "./"
        }
      }
    },
    "target:debug": {
      "module": {
        "optimizer": {
          "cssnano": null
        }
      }
    },
    "target:deploy": {
      "assetPattern": {
        "javaScript": {
          "pattern": {
            "#": "This is how we can make our main exported artefact executable.",
            "__evaluate__": "`#!/usr/bin/env node\n// -*- coding: utf-8 -*-\n{1}`"
          }
        }
      },
      "files": {
        "defaultHTML": {
          "template": {
            "filePath": "none"
          }
        }
      },
      "injection": {
        "entry": {
          "__evaluate__": "2 < self.givenCommandLineArguments.length && self.givenCommandLineArguments[2].startsWith('test') ? {testBundle: './test.ts'} : {deploy: './deploy'}"
        }
      },
      "module": {
        "optimizer": {
          "terser": {
            "terserOptions": {
              "compress": {
                "#": "To provide a logging output we need to exclude this feature.",
                "drop_console": {
                  "__evaluate__": "false"
                },
                "drop_debugger": {
                  "__evaluate__": "false"
                }
              }
            }
          }
        }
      },
      "targetTechnology": {
        "boilerplate": "node",
        "payload": "node"
      }
    },
    "webpack": {
      "snapshot": {
        "unmanagedPaths": [
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]clientnode[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]web-component-wrapper[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]web-internationalization[\\/]/"
          },
          {
            "__evaluate__": "/^.+?[\\/]node_modules[\\/]website-utilities[\\/]/"
          }
        ]
      },
      "watchOptions": {
        "ignored": {
          "__remove__": "**/node_modules"
        }
      }
    }
  },
  "packageManager": "yarn@4.14.1+sha512.64df448055b2d37ba269d7db535a469b8da93f8ef1140c25fd7a83c00a8fbaacb214ca0e02553b92a2c54cef78bb67d0b4817fab02001df0e24fac0faccc3b42"
}
